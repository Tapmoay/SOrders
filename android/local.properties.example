# 复制为 android/local.properties 后填写（local.properties 已被 .gitignore 忽略）
# 注意：Android Studio 会自动生成 sdk.dir；如手动配置请保留 sdk.dir
sdk.dir=C:/Users/你的用户名/AppData/Local/Android/Sdk

# 高德开放平台（lbs.amap.com）申请的 Android SDK Key
amap_key=你的高德AndroidSDKKey

# 后端地址：真机联调用局域网 IP，模拟器用 http://10.0.2.2:8000
api_base_url=http://192.168.1.100:8000
