<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标前景层 = **登录页那个货车图标**（2026-09-19 换成与登录页一致）。

  ### 这个形状是哪来的（不是手画的）
  它是 Material Icons 的 `LocalShipping` —— 也就是登录页 `LoginScreen.kt` 里
  `Icons.Default.LocalShipping` 用的那一个。手抄 SVG 会走形，所以这里是**从字节码里
  反读出来的**：`androidx.compose.material.icons.filled.LocalShippingKt` 的 `PathBuilder`
  调用序列（`javap -c`）逐条还原成 SVG 路径，再展开成 Android 认的写法。
  24×24 viewport，与原图标**几何完全一致**。

  ### 两条踩坑（改这个文件之前先读）
  1. **SVG 的隐式重复命令 Android 不认**：Material 的原始路径写成
     `s.67-1.5 1.5-1.5 1.5.67 1.5 1.5`（第二个 `s` 省略了字母），
     Android 的 PathParser 要求每个命令字母都写出来 —— 所以下面每个 `s` 都带字母。
  2. **缩放要按"可见区"算，不是按整块画布**：自适应图标层是 108×108，但遮罩最多吃到
     半径 36（可见区只有中心 72×72）。货车墨迹宽 44/72 ≈ 可见区的 61%，
     与登录页那个方块里 44dp 图标占 80dp 的比例（55%）接近。
     换尺寸时**只改下面 group 的 scaleX/scaleY 与 translate**：
     `scale = 目标宽 / 24`，`translate = (108 - 目标宽) / 2`。

  ### 颜色
  `#0A3168` = 主题的 `OnPrimaryContainer`（登录页图标的 tint）。改这里要连着
  `ic_launcher_background.xml`（底）与 `ic_launcher_monochrome.xml`（主题图标）一起改。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 24 viewport → 44 可见宽：scale = 44/24 = 1.83333，translate = (108-44)/2 = 32 -->
    <group
        android:scaleX="1.83333"
        android:scaleY="1.83333"
        android:translateX="32"
        android:translateY="32">
        <!-- 车身（货箱+驾驶室+挡风斜边）、两个轮子、驾驶室侧窗，共 4 段子路径 -->
        <path
            android:fillColor="#0A3168"
            android:pathData="M20,8 h-3 V4 H3 c-1.1,0,-2,0.9,-2,2 v11 h2 c0,1.66,1.34,3,3,3 s3,-1.34,3,-3 h6 c0,1.66,1.34,3,3,3 s3,-1.34,3,-3 h2 v-5 l-3,-4 z M6,18.5 c-0.83,0,-1.5,-0.67,-1.5,-1.5 s0.67,-1.5,1.5,-1.5 s1.5,0.67,1.5,1.5 s-0.67,1.5,-1.5,1.5 z M19.5,9.5 l1.96,2.5 L17,12 L17,9.5 h2.5 z M18,18.5 c-0.83,0,-1.5,-0.67,-1.5,-1.5 s0.67,-1.5,1.5,-1.5 s1.5,0.67,1.5,1.5 s-0.67,1.5,-1.5,1.5 z" />
    </group>
</vector>
