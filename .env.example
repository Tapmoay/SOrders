# 派单送货系统 — 环境变量示例（复制为 .env 并填写真实值，勿提交密钥）

# ---------- 高德地图（Web 选点 / 导航）----------
# 复制本文件为仓库根目录 `.env`；Vite 已配置为从根目录加载 `VITE_*`。
# 前端 Vite 需使用 VITE_ 前缀；Key 类型选「Web 端 (JS API)」
VITE_AMAP_KEY=
# JS API 2.0 必填：控制台 Key 详情里的「安全密钥」；与 Key 配套，勿提交仓库
VITE_AMAP_SECURITY_JS_CODE=

# 后端 Settings.amap_key；仅当服务端调用高德 Web 服务 API 时必填（可与上为同一 Key 或单独创建）
AMAP_KEY=

# ---------- 后端 FastAPI（backend/.env 或仓库根 .env）----------
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/sorders
# JWT_SECRET_KEY=change-me-use-long-random-string
# DEBUG=false
# 注册验证码：后端未接短信网关时不会发短信；DEBUG=true 或下方为 true 时接口会回显验证码供开发使用（生产务必关闭）
# SMS_REVEAL_CODE=false

# ---------- 前端（frontend/.env.development 等）----------
# 开发时可用相对路径 + Vite 代理到后端；生产填完整 API 根路径（含 /api/v1）
# VITE_API_BASE_URL=/api/v1
# VITE_PROXY_TARGET=http://127.0.0.1:8000
# VITE_DEV_PORT=5173

# ---------- 应用 ----------
# NODE_ENV=production
# VITE_API_BASE_URL=https://api.example.com/api/v1

# ---------- 可选：对象存储（导出文件、图片）----------
# OSS_ENDPOINT=
# OSS_BUCKET=
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=

# ---------- Redis（缓存 / PubSub / 队列）----------
# REDIS_URL=redis://localhost:6379/0

# ---------- Docker / Uvicorn（反向代理）----------
# 容器或 systemd 启动、且经 Nginx/Ingress 反代时设为 1，便于 X-Forwarded-*（仅信任上游代理）
# UVICORN_PROXY_HEADERS=1
